{
  "name": "vikunja-desktop",
  "version": "2.7.1-aster.56",
  "description": "Astering frontend as a standalone desktop application, based on Vikunja.",
  "main": "main.js",
  "repository": "https://github.com/KanameMadoka520/Astering",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.27.0",
  "author": {
    "email": "90090108+KanameMadoka520@users.noreply.github.com",
    "name": "KanameMadoka520"
  },
  "homepage": "https://github.com/KanameMadoka520/Astering",
  "scripts": {
    "brand:assets": "node scripts/brand-assets.mjs",
    "build:frontend": "cd ../frontend && pnpm run build && cd ../desktop && rm -rf frontend && cp -r ../frontend/dist frontend",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "io.vikunja.desktop",
    "files": [
      "**/*",
      "preload-quick-entry.js"
    ],
    "productName": "Astering",
    "artifactName": "${productName}-${version}.${ext}",
    "icon": "build/icon.icns",
    "protocols": {
      "name": "Astering Desktop",
      "schemes": [
        "vikunja-desktop"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "snap",
        "pacman",
        "apk",
        "freebsd",
        "rpm",
        "zip",
        "tar.gz"
      ],
      "category": "Productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "msi",
        "zip"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "electron": "43.7.0",
    "electron-builder": "26.15.3",
    "unzipper": "0.12.5"
  },
  "dependencies": {
    "express": "5.2.1"
  }
}
